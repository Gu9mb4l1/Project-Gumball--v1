-- Cards flow vertically, so no controls are hidden below the page.
local function makeSection(page, titleText, description)
	local card = Instance.new("Frame")
	card.Name = titleText:gsub("%W", "") .. "Section"
	card.Size = UDim2.new(1, -2, 0, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = COLORS.Card
	card.BorderSizePixel = 0
	card.Parent = page
	corner(card, 9)
	stroke(card, COLORS.Border, 1)

	local heading = label(
		card,
		"SectionTitle",
		titleText,
		UDim2.new(1, -28, 0, 22),
		UDim2.fromOffset(14, 10),
		Enum.Font.GothamBold,
		COLORS.White
	)
	heading.TextSize = 13

	if description then
		local desc = label(
			card,
			"SectionDescription",
			description,
			UDim2.new(1, -28, 0, 18),
			UDim2.fromOffset(14, 32),
			Enum.Font.Gotham,
			COLORS.Muted
		)
		desc.TextSize = 10
	end

	local rows = Instance.new("Frame")
	rows.Name = "Rows"
	rows.Position = UDim2.fromOffset(12, description and 58 or 36)
	rows.Size = UDim2.new(1, -24, 0, 0)
	rows.AutomaticSize = Enum.AutomaticSize.Y
	rows.BackgroundTransparency = 1
	rows.Parent = card

	local rowsLayout = Instance.new("UIListLayout")
	rowsLayout.FillDirection = Enum.FillDirection.Vertical
	rowsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rowsLayout.Padding = UDim.new(0, 6)
	rowsLayout.Parent = rows

	return card, rows
end

local function makeToggle(rows, name, description, callback)
	local row = Instance.new("Frame")
	row.Name = name:gsub("%W", "") .. "Row"
	row.Size = UDim2.new(1, 0, 0, 48)
	row.BackgroundColor3 = COLORS.Row
	row.BorderSizePixel = 0
	row.Parent = rows
	corner(row, 7)

	local titleLabel = label(
		row,
		"Title",
		name,
		UDim2.new(1, -100, 0, 21),
		UDim2.fromOffset(10, 5),
		Enum.Font.GothamMedium,
		COLORS.White
	)
	titleLabel.TextSize = 11

	local descLabel = label(
		row,
		"Description",
		description or "",
		UDim2.new(1, -100, 0, 17),
		UDim2.fromOffset(10, 26),
		Enum.Font.Gotham,
		COLORS.Muted
	)
	descLabel.TextSize = 9

	local button = Instance.new("TextButton")
	button.Name = "Toggle"
	button.AnchorPoint = Vector2.new(1, 0.5)
	button.Position = UDim2.new(1, -8, 0.5, 0)
	button.Size = UDim2.fromOffset(54, 27)
	button.BackgroundColor3 = COLORS.Selected
	button.BorderSizePixel = 0
	button.Text = "OFF"
	button.TextColor3 = COLORS.Inactive
	button.TextSize = 10
	button.Font = Enum.Font.GothamBold
	button.AutoButtonColor = false
	button.Parent = row
	corner(button, 6)
	stroke(button, COLORS.Border, 1)

	-- All toggles start OFF.
	local enabled = false

	local function refresh()
		button.Text = enabled and "ON" or "OFF"
		button.BackgroundColor3 = enabled and COLORS.Green or COLORS.Selected
		button.TextColor3 = enabled and COLORS.Background or COLORS.Inactive
	end

	button.Activated:Connect(function()
		enabled = not enabled
		refresh()
		if callback then
			callback(enabled)
		end
	end)

	refresh()
	return button
end

local function makeSlider(rows, name, minValue, maxValue, callback)
	local row = Instance.new("Frame")
	row.Name = name:gsub("%W", "") .. "Slider"
	row.Size = UDim2.new(1, 0, 0, 62)
	row.BackgroundColor3 = COLORS.Row
	row.BorderSizePixel = 0
	row.Parent = rows
	corner(row, 7)

	local titleLabel = label(
		row,
		"Title",
		name,
		UDim2.new(1, -64, 0, 21),
		UDim2.fromOffset(10, 4),
		Enum.Font.GothamMedium,
		COLORS.White
	)
	titleLabel.TextSize = 11

	local valueLabel = label(
		row,
		"Value",
		"0",
		UDim2.new(0, 44, 0, 21),
		UDim2.new(1, -54, 0, 4),
		Enum.Font.GothamBold,
		COLORS.Green
	)
	valueLabel.TextSize = 11
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right

	local track = Instance.new("TextButton")
	track.Name = "Track"
	track.Position = UDim2.new(0, 10, 0, 36)
	track.Size = UDim2.new(1, -20, 0, 10)
	track.BackgroundColor3 = COLORS.Selected
	track.BorderSizePixel = 0
	track.Text = ""
	track.AutoButtonColor = false
	track.ClipsDescendants = false
	track.Parent = row
	corner(track, 5)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = COLORS.Green
	fill.BorderSizePixel = 0
	fill.Parent = track
	corner(fill, 5)

	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new(0, 0, 0.5, 0)
	knob.Size = UDim2.fromOffset(12, 12)
	knob.BackgroundColor3 = COLORS.White
	knob.BorderSizePixel = 0
	knob.Parent = track
	corner(knob, 6)
	stroke(knob, COLORS.Green, 1)

	-- Every slider starts at 0.
	local value = 0
	local draggingSlider = false

	local function setValue(newValue)
		value = math.clamp(newValue, minValue, maxValue)
		local fraction = 0

		if maxValue > minValue then
			fraction = (value - minValue) / (maxValue - minValue)
		end

		fill.Size = UDim2.new(fraction, 0, 1, 0)
		knob.Position = UDim2.new(fraction, 0, 0.5, 0)
		valueLabel.Text = tostring(math.floor(value * 100 + 0.5) / 100)

		if callback then
			callback(value)
		end
	end

	local function updateFromInput(input)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end

		local fraction = math.clamp(
			(input.Position.X - track.AbsolutePosition.X) / width,
			0,
			1
		)

		setValue(minValue + fraction * (maxValue - minValue))
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = true
			updateFromInput(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if draggingSlider and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			updateFromInput(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = false
		end
	end)

	-- Set the visual position to zero without applying a nonzero value.
	setValue(0)
	return function()
		return value
	end
end

local function makeButton(rows, name, callback)
	local button = Instance.new("TextButton")
	button.Name = name:gsub("%W", "") .. "Button"
	button.Size = UDim2.new(1, 0, 0, 36)
	button.BackgroundColor3 = COLORS.Selected
	button.BorderSizePixel = 0
	button.Text = name
	button.TextColor3 = COLORS.White
	button.TextSize = 11
	button.Font = Enum.Font.GothamMedium
	button.AutoButtonColor = false
	button.Parent = rows
	corner(button, 7)
	stroke(button, COLORS.Border, 1)

	button.Activated:Connect(function()
		if callback then
			callback()
		end
	end)

	return button
end

