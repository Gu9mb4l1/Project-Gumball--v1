local function SelectCategory(Name)
    SelectedCategory = Name

    for _, CategoryName in ipairs(CategoryNames) do
        local Button = CategoryButtons[CategoryName]
        local Indicator = ActiveIndicators[CategoryName]
        local Page = CategoryPages[CategoryName]

        if Button then
            Button.TextColor3 = CategoryName == Name
                and TextColor
                or MutedColor
        end

        if Indicator then
            Indicator.Visible = CategoryName == Name
        end

        if Page then
            Page.Visible = CategoryName == Name
        end
    end

    if Name == "Main" then
        SelectSubcategory(SelectedSubcategory)
    end
end

