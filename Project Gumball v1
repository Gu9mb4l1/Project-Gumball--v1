-- Tab definitions
local TabDefinitions = {
    Main = {"Main", "Rage", "Weapons"},
    World = {"Lighting", "Custom World", "Custom Sky"},
    ESP = {"ESP", "Crosshair", "Weapon Visuals", "Camera"},
    Visuals = {},
    Character = {"Movement"},
    Misc = {"Cosmetic", "Rank", "Detection"},
    Settings = {"General", "Config"}
}

local TabOrder = {
    "Main", "World", "ESP", "Visuals",
    "Character", "Misc", "Settings"
}

local TabWidths = {
    Main = 88,
    World = 88,
    ESP = 78,
    Visuals = 96,
    Character = 116,
    Misc = 78,
    Settings = 104
}

local TabButtons = {}
local TabIndicators = {}
