local function worldToggle(parent, name, description, initial, callback)
    local row = worldRow(parent, name, description)
    local value = initial == true

    local button = Instance.new("TextButton")
    button.AnchorPoint = Vector2.new(1, 0.5)
    button.Position = UDim2.new(1, -10, 0.5, 0)
    button.Size = UDim2.fromOffset(62, 28)
    button.BackgroundColor3 = value and COLORS.Green or COLORS.Selected
    button.BorderSizePixel = 0
    button.Text = value and "ON" or "OFF"
    button.TextColor3 = value and COLORS.Background or COLORS.Inactive
    button.TextSize = 11
    button.Font = Enum.Font.GothamBold
    button.Parent = row
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

    button.Activated:Connect(function()
        value = not value
        button.Text = value and "ON" or "OFF"
        button.BackgroundColor3 = value and COLORS.Green or COLORS.Selected
        button.TextColor3 = value and COLORS.Background or COLORS.Inactive
        callback(value)
    end)

    return button
end

local function worldSlider(parent, name, description, minValue, maxValue, initial, decimals, callback)
    local row = worldRow(parent, name, description, 66)
    local value = math.clamp(initial, minValue, maxValue)

    local valueLabel = makeLabel(
        row, "Value", tostring(value),
        UDim2.new(1, -110, 0, 5),
        UDim2.fromOffset(96, 20),
        11, COLORS.White, Enum.Font.GothamMedium
    )
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame")
    track.Position = UDim2.new(0, 12, 1, -15)
    track.Size = UDim2.new(1, -24, 0, 4)
    track.BackgroundColor3 = Color3.fromRGB(37, 40, 46)
    track.BorderSizePixel = 0
    track.Parent = row
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = COLORS.White
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size = UDim2.fromOffset(10, 10)
    knob.BackgroundColor3 = COLORS.White
    knob.BorderSizePixel = 0
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local dragging = false

    local function update(x)
        local alpha = math.clamp(
            (x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1),
            0, 1
        )

        local multiplier = 10 ^ (decimals or 0)
        value = minValue + (maxValue - minValue) * alpha
        value = math.floor(value * multiplier + 0.5) / multiplier

        local progress = (value - minValue) / (maxValue - minValue)
        fill.Size = UDim2.new(progress, 0, 1, 0)
        knob.Position = UDim2.new(progress, 0, 0.5, 0)
        valueLabel.Text = tostring(value)
        callback(value)
    end

    local function renderInitial()
        local progress = (value - minValue) / (maxValue - minValue)
        fill.Size = UDim2.new(progress, 0, 1, 0)
        knob.Position = UDim2.new(progress, 0, 0.5, 0)
    end
    renderInitial()

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

