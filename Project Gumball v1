local function SelectSubcategory(Name)
    SelectedSubcategory = Name

    for _, SubName in ipairs(SubcategoryNames) do
        local Button = SubcategoryButtons[SubName]
        local Indicator = SubcategoryIndicators[SubName]
        local Page = SubcategoryPages[SubName]

        if Button then
            Button.TextColor3 = SubName == Name
                and TextColor
                or MutedColor
        end

        if Indicator then
            Indicator.Visible = SubName == Name
        end

        if Page then
            Page.Visible = SubName == Name
        end
    end
end

