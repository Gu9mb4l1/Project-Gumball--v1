-- Local weather particles. Only affect the local player's view.
local weatherOn = false
local weatherType = "Rain"
local weatherRate = 300
local weatherSpeed = 90
local weatherHeight = 50
local weatherSize = 0.4
local weatherAnchor
local weatherEmitter
local weatherConnection

local weatherTextures = {
    Rain = "rbxassetid://241876005",
    Snow = "rbxasset://textures/particles/sparkles_main.dds",
    Blizzard = "rbxasset://textures/particles/sparkles_main.dds",
}

local function stopWeather()
    weatherOn = false
    if weatherConnection then
        weatherConnection:Disconnect()
        weatherConnection = nil
    end
    if weatherAnchor then
        weatherAnchor:Destroy()
        weatherAnchor = nil
        weatherEmitter = nil
    end
end

local function startWeather()
    stopWeather()
    weatherOn = true

    weatherAnchor = Instance.new("Part")
    weatherAnchor.Name = "GumballLocalWeather"
    weatherAnchor.Anchored = true
    weatherAnchor.CanCollide = false
    weatherAnchor.CanTouch = false
    weatherAnchor.CanQuery = false
    weatherAnchor.Transparency = 1
    weatherAnchor.Size = Vector3.new(1, 1, 1)
    weatherAnchor.Parent = workspace

    weatherEmitter = Instance.new("ParticleEmitter")
    weatherEmitter.Texture = weatherTextures[weatherType]
    weatherEmitter.Rate = weatherRate
    weatherEmitter.Lifetime = NumberRange.new(1.2, 2.5)
    weatherEmitter.Speed = NumberRange.new(weatherSpeed * 0.75, weatherSpeed)
    weatherEmitter.Size = NumberSequence.new(weatherSize)
    weatherEmitter.EmissionDirection = Enum.NormalId.Bottom
    weatherEmitter.Acceleration = Vector3.new(0, -35, 0)
    weatherEmitter.Parent = weatherAnchor

    if weatherType ~= "Rain" then
        weatherEmitter.Speed = NumberRange.new(weatherSpeed * 0.1, weatherSpeed * 0.3)
        weatherEmitter.Lifetime = NumberRange.new(3, 6)
        weatherEmitter.Acceleration = Vector3.new(0, -4, 0)
        weatherEmitter.SpreadAngle = Vector2.new(weatherType == "Blizzard" and 45 or 12, weatherType == "Blizzard" and 45 or 12)
    end

    weatherConnection = RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        if weatherAnchor and camera then
            weatherAnchor.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, weatherHeight, 0))
        end
    end)
end

worldToggle(skyPage, "Weather", "Enable local rain or snow particles", false, function(on)
    if on then startWeather() else stopWeather() end
end)

worldButton(skyPage, "Weather preset", "Cycle Rain, Snow and Blizzard", "CHANGE TYPE", function()
    local types = {"Rain", "Snow", "Blizzard"}
    local index = table.find(types, weatherType) or 1
    weatherType = types[(index % #types) + 1]
    if weatherOn then startWeather() end
end)

