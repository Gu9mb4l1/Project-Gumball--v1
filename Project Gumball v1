local function makeChips(
    parent,
    options,
    startY,
    selectedMap,
    prefix
)
    local chipFrame = Instance.new("Frame")
    chipFrame.Name = prefix .. "Options"
    chipFrame.Position = UDim2.fromOffset(24, startY)
    chipFrame.Size = UDim2.new(1, -48, 0, 72)
    chipFrame.BackgroundTransparency = 1
    chipFrame.Parent = parent

    local grid = Instance.new("UIGridLayout")
    grid.CellSize = UDim2.new(0, 132, 0, 28)
    grid.CellPadding = UDim2.fromOffset(8, 8)
    grid.SortOrder = Enum.SortOrder.LayoutOrder
    grid.Parent = chipFrame

    for i, option in ipairs(options) do
        local chip = Instance.new("TextButton")
        chip.Name = option .. "Option"
        chip.LayoutOrder = i
        chip.BackgroundColor3 =
            selectedMap[option] and COLORS.Selected or COLORS.Background
        chip.BorderSizePixel = 0
        chip.Text = option
        chip.TextColor3 =
            selectedMap[option] and COLORS.White or COLORS.Inactive
        chip.TextSize = 11
        chip.Font = Enum.Font.Gotham
        chip.Parent = chipFrame

        Instance.new("UICorner", chip).CornerRadius = UDim.new(0, 6)

        local stroke = Instance.new("UIStroke")
        stroke.Color =
            selectedMap[option] and COLORS.White or COLORS.Border
        stroke.Thickness = 1
        stroke.Parent = chip

        chip.Activated:Connect(function()
            selectedMap[option] = not selectedMap[option]

            chip.BackgroundColor3 =
                selectedMap[option] and COLORS.Selected or COLORS.Background

            chip.TextColor3 =
                selectedMap[option] and COLORS.White or COLORS.Inactive

            stroke.Color =
                selectedMap[option] and COLORS.White or COLORS.Border

            if unlockEnabled then
                sendUnlockRequest()
            end
        end)
    end
end

