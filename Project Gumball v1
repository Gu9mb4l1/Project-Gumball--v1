local weatherSection = worldSection("WEATHER")

local weatherFolder = Instance.new("Folder")
weatherFolder.Name = "GumballLocalWeather"
weatherFolder.Parent = workspace

local weatherPart
local weatherEmitter
local weatherEnabled = false
local weatherPreset = "Rain"
local weatherRate = 250
local weatherSpeed = 70
local weatherSize = 0.12
local weatherConnection

local function clearWeather()
    if weatherConnection then
        weatherConnection:Disconnect()
        weatherConnection = nil
    end
    if weatherPart then
        weatherPart:Destroy()
        weatherPart = nil
        weatherEmitter = nil
    end
end

local function createWeather()
    clearWeather()
    if not weatherEnabled then return end

    local camera = workspace.CurrentCamera
    if not camera then return end

    weatherPart = Instance.new("Part")
    weatherPart.Name = "LocalWeatherAnchor"
    weatherPart.Anchored = true
    weatherPart.CanCollide = false
    weatherPart.CanQuery = false
    weatherPart.CanTouch = false
    weatherPart.Transparency = 1
    weatherPart.Size = Vector3.new(1, 1, 1)
    weatherPart.Parent = weatherFolder

    local attachment = Instance.new("Attachment")
    attachment.Parent = weatherPart

    weatherEmitter = Instance.new("ParticleEmitter")
    weatherEmitter.Name = "WeatherParticles"
    weatherEmitter.Parent = attachment
    weatherEmitter.Enabled = true
    weatherEmitter.Rate = weatherRate
    weatherEmitter.Speed = NumberRange.new(weatherSpeed * 0.8, weatherSpeed)
    weatherEmitter.Lifetime = NumberRange.new(1.5, 3)
    weatherEmitter.SpreadAngle = Vector2.new(20, 20)
    weatherEmitter.LightEmission = 0.1

    if weatherPreset == "Snow" then
        weatherEmitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        weatherEmitter.Rate = weatherRate * 0.4
        weatherEmitter.Speed = NumberRange.new(5, 10)
        weatherEmitter.Lifetime = NumberRange.new(4, 7)
        weatherEmitter.Size = NumberSequence.new(0.2, 0.35)
        weatherEmitter.Acceleration = Vector3.new(0, -2, 0)
    elseif weatherPreset == "Blizzard" then
        weatherEmitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        weatherEmitter.Rate = weatherRate * 1.5
        weatherEmitter.Speed = NumberRange.new(15, 28)
        weatherEmitter.Lifetime = NumberRange.new(2, 4)
        weatherEmitter.Size = NumberSequence.new(0.25, 0.4)
        weatherEmitter.Acceleration = Vector3.new(8, -5, 0)
    else
        weatherEmitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
        weatherEmitter.Rate = weatherRate
        weatherEmitter.Speed = NumberRange.new(weatherSpeed, weatherSpeed + 20)
        weatherEmitter.Lifetime = NumberRange.new(0.6, 1.2)
        weatherEmitter.Size = NumberSequence.new(weatherSize)
        weatherEmitter.Acceleration = Vector3.new(0, -30, 0)
    end

    weatherConnection = RunService.RenderStepped:Connect(function()
        local currentCamera = workspace.CurrentCamera
        if currentCamera and weatherPart then
            weatherPart.CFrame = currentCamera.CFrame * CFrame.new(0, 18, -8)
        end
    end)
end

