local function setStatus(message, color)
	status.Text = message
	status.TextColor3 = color or COLORS.Amber
end

unlockAllButton.Activated:Connect(function()
	if not unlockRemote
		or not unlockRemote:IsA("RemoteFunction") then
		setStatus(
			"Missing GumballUnlockCosmetics RemoteFunction."
		)
		return
	end

	unlockAllButton.Text = "UNLOCKING..."
	unlockAllButton.Active = false

	local ok, result = pcall(function()
		return unlockRemote:InvokeServer({
			enabled = true,
			types = {},
			rarities = {},
		})
	end)

	unlockAllButton.Text = "UNLOCK ALL"
	unlockAllButton.Active = true

	if ok and type(result) == "table" then
		setStatus(
			result.message or "Unlock request completed.",
			result.ok == false and COLORS.Amber or COLORS.Green
		)
	elseif ok and result then
		setStatus("Unlock request completed.", COLORS.Green)
	else
		setStatus(
			"Unlock request failed. Check your server script."
		)
	end
end)

