local function selectTab(name)
	currentTab = name

	for tabName, parts in pairs(tabParts) do
		local active = tabName == currentTab
		parts.TextColor3 = active and COLORS.White or COLORS.Inactive
		parts.Line.Visible = active
	end

	for pageName, page in pairs(pages) do
		page.Visible = pageName == currentTab
	end
end

