local SubTabPages = {}
local SelectedSubTab = {}

local function CreatePage(Name, Parent)
    local Page = Instance.new("Frame")
    Page.Name = Name
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.Visible = false
    Page.Parent = Parent
    return Page
end

-- Create pages and sub-tabs
for _, TabName in ipairs(TabOrder) do
    TabPages[TabName] = CreatePage(TabName .. "Page", Content)

    local SubTabs = TabDefinitions[TabName]

    if #SubTabs > 0 then
        local SubTabBar = Instance.new("ScrollingFrame")
        SubTabBar.Name = "SubTabBar"
        SubTabBar.Position = UDim2.fromOffset(14, 12)
        SubTabBar.Size = UDim2.new(1, -28, 0, 34)
        SubTabBar.BackgroundTransparency = 1
        SubTabBar.BorderSizePixel = 0
        SubTabBar.ScrollBarThickness = 0
        SubTabBar.ScrollingDirection = Enum.ScrollingDirection.X
        SubTabBar.AutomaticCanvasSize = Enum.AutomaticSize.X
        SubTabBar.CanvasSize = UDim2.new(0, 0, 0, 0)
        SubTabBar.Active = true
        SubTabBar.Parent = TabPages[TabName]

        local Layout = Instance.new("UIListLayout")
        Layout.FillDirection = Enum.FillDirection.Horizontal
        Layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
        Layout.VerticalAlignment = Enum.VerticalAlignment.Center
        Layout.SortOrder = Enum.SortOrder.LayoutOrder
        Layout.Padding = UDim.new(0, 8)
        Layout.Parent = SubTabBar

        local SubTabContent = Instance.new("Frame")
        SubTabContent.Name = "SubTabContent"
        SubTabContent.Position = UDim2.fromOffset(14, 54)
        SubTabContent.Size = UDim2.new(1, -28, 1, -66)
        SubTabContent.BackgroundTransparency = 1
        SubTabContent.BorderSizePixel = 0
        SubTabContent.Parent = TabPages[TabName]

        SubTabButtons[TabName] = {}
        SubTabIndicators[TabName] = {}
        SubTabPages[TabName] = {}

        for Index, SubTabName in ipairs(SubTabs) do
            local Page = CreatePage(
                SubTabName:gsub("%s+", "") .. "Page",
                SubTabContent
            )
            SubTabPages[TabName][SubTabName] = Page

            local Button = Instance.new("TextButton")
            Button.Name = SubTabName:gsub("%s+", "") .. "Button"
            Button.Size = UDim2.fromOffset(
                math.max(76, #SubTabName * 8 + 24),
                32
            )
            Button.BackgroundColor3 = HeaderColor
            Button.BorderSizePixel = 0
            Button.Text = SubTabName
            Button.TextColor3 = MutedColor
            Button.TextSize = 13
            Button.Font = Enum.Font.Gotham
            Button.LayoutOrder = Index
            Button.AutoButtonColor = false
            Button.Parent = SubTabBar

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 4)
            Corner.Parent = Button

            local Stroke = Instance.new("UIStroke")
            Stroke.Color = LineColor
            Stroke.Thickness = 1
            Stroke.Parent = Button

            local Indicator = Instance.new("Frame")
            Indicator.Name = "ActiveIndicator"
            Indicator.Size = UDim2.new(1, -20, 0, 2)
            Indicator.AnchorPoint = Vector2.new(0.5, 1)
            Indicator.Position = UDim2.new(0.5, 0, 1, -3)
            Indicator.BackgroundColor3 = TextColor
            Indicator.BorderSizePixel = 0
            Indicator.Visible = false
            Indicator.Parent = Button

            SubTabButtons[TabName][SubTabName] = Button
            SubTabIndicators[TabName][SubTabName] = Indicator

            Button.Activated:Connect(function()
                SelectedSubTab[TabName] = SubTabName

                for _, Name in ipairs(SubTabs) do
                    local Selected = Name == SubTabName

                    SubTabButtons[TabName][Name].TextColor3 =
                        Selected and TextColor or MutedColor

                    SubTabIndicators[TabName][Name].Visible = Selected
                    SubTabPages[TabName][Name].Visible = Selected
                end
            end)
        end

        SelectedSubTab[TabName] = SubTabs[1]
        SubTabButtons[TabName][SubTabs[1]].TextColor3 = TextColor
        SubTabIndicators[TabName][SubTabs[1]].Visible = true
        SubTabPages[TabName][SubTabs[1]].Visible = true
    end
end

-- Select top-level tab
local function SelectTab(TabName)
    for _, Name in ipairs(TabOrder) do
        local Selected = Name == TabName

        TabButtons[Name].TextColor3 =
            Selected and TextColor or MutedColor

        TabIndicators[Name].Visible = Selected
        TabPages[Name].Visible = Selected
    end
end

-- Create top-level buttons
for Index, TabName in ipairs(TabOrder) do
    local Button = Instance.new("TextButton")
    Button.Name = TabName .. "Button"
    Button.Size = UDim2.new(0, TabWidths[TabName], 1, 0)
    Button.BackgroundTransparency = 1
    Button.BorderSizePixel = 0
    Button.Text = TabName
    Button.TextColor3 = MutedColor
    Button.TextSize = 13
    Button.Font = Enum.Font.Gotham
    Button.LayoutOrder = Index
    Button.AutoButtonColor = false
    Button.Parent = Categories

    local Indicator = Instance.new("Frame")
    Indicator.Name = "ActiveIndicator"
    Indicator.Size = UDim2.new(
        0, math.max(20, TabWidths[TabName] - 28), 0, 2
    )
    Indicator.AnchorPoint = Vector2.new(0.5, 1)
    Indicator.Position = UDim2.new(0.5, 0, 1, -2)
    Indicator.BackgroundColor3 = TextColor
    Indicator.BorderSizePixel = 0
    Indicator.Visible = false
    Indicator.Parent = Button

    TabButtons[TabName] = Button
    TabIndicators[TabName] = Indicator

    Button.Activated:Connect(function()
        SelectTab(TabName)
    end)
end

-- Responsive sizing: smaller on mobile, original size on PC
local function UpdateMenuSize()
    local Camera = workspace.CurrentCamera
    if not Camera then
        return
    end

    local Viewport = Camera.ViewportSize

    if IsMobile then
        local Width = math.min(500, Viewport.X - 24)
        local Height = math.min(340, Viewport.Y - 100)

        Width = math.max(280, Width)
        Height = math.max(240, Height)

        Window.Size = UDim2.fromOffset(Width, Height)
        Window.Position = UDim2.new(0.5, -Width / 2, 0.5, -Height / 2)

        Title.TextSize = 16
        Title.Size = UDim2.new(0, 95, 1, 0)

        Categories.Position = UDim2.new(0, 110, 0, 0)
        Categories.Size = UDim2.new(1, -116, 1, 0)
    else
        Window.Size = UDim2.fromOffset(620, 390)
        Window.Position = UDim2.new(0.5, -310, 0.5, -195)

        Title.TextSize = 18
        Title.Size = UDim2.new(0, 115, 1, 0)

        Categories.Position = UDim2.new(0, 132, 0, 0)
        Categories.Size = UDim2.new(1, -140, 1, 0)
    end
end

UpdateMenuSize()

if workspace.CurrentCamera then
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateMenuSize)
end

-- Select initial tab
SelectTab("Main")

-- Drag the main window
local WindowDragging = false
local WindowDragStart
local WindowStartPosition
local WindowDragInput

Header.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then

        WindowDragging = true
        WindowDragStart = Input.Position
        WindowStartPosition = Window.Position

        Input.Changed:Connect(function()
            if Input.UserInputState == Enum.UserInputState.End then
                WindowDragging = false
            end
        end)
    end
end)

Header.InputChanged:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseMovement
        or Input.UserInputType == Enum.UserInputType.Touch then
        WindowDragInput = Input
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if WindowDragging
        and (Input == WindowDragInput
        or Input.UserInputType == Enum.UserInputType.Touch) then

        local Delta = Input.Position - WindowDragStart

        Window.Position = UDim2.new(
            WindowStartPosition.X.Scale,
            WindowStartPosition.X.Offset + Delta.X,
            WindowStartPosition.Y.Scale,
            WindowStartPosition.Y.Offset + Delta.Y
        )
    end
end)

-- PC toggle with RightShift
UserInputService.InputBegan:Connect(function(Input, GameProcessed)
    if GameProcessed then
        return
    end

    if Input.KeyCode == Enum.KeyCode.RightShift then
        Window.Visible = not Window.Visible
    end
end)

