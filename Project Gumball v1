-- Save original Lighting properties for Reset World.
local originalLighting = {}
for _, property in ipairs({
    "ClockTime", "GeographicLatitude", "Brightness",
    "ExposureCompensation", "GlobalShadows", "ShadowSoftness",
    "Ambient", "OutdoorAmbient", "ColorShift_Top", "ColorShift_Bottom",
    "EnvironmentDiffuseScale", "EnvironmentSpecularScale",
    "FogColor", "FogStart", "FogEnd"
}) do
    originalLighting[property] = Lighting[property]
end

local originalSky
for _, child in ipairs(Lighting:GetChildren()) do
    if child:IsA("Sky") then
        originalSky = child:Clone()
        break
    end
end

local function getWorldEffect(className, name)
    local effectName = "GumballWorld_" .. name
    local effect = Lighting:FindFirstChild(effectName)

    if not effect or effect.ClassName ~= className then
        if effect then effect:Destroy() end
        effect = Instance.new(className)
        effect.Name = effectName
        effect.Parent = Lighting
    end

    return effect
end

