UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.KeyCode == Enum.KeyCode.RightShift and not IsMobile then
        Window.Visible = not Window.Visible

        if Window.Visible then
            SelectMainTab(CurrentMainTab)
        else
            Sidebar.Visible = false
        end
    end
end)

-- Responsive sizing
local function UpdateMenuSize()
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local viewport = camera.ViewportSize
    IsMobile = UserInputService.TouchEnabled
        and not UserInputService.KeyboardEnabled

    ToggleButton.Visible = IsMobile

    if IsMobile then
        local width = math.max(280, math.min(500, viewport.X - 24))
        local height = math.max(240, math.min(340, viewport.Y - 100))

        Window.Size = UDim2.fromOffset(width, height)
        Window.Position = UDim2.fromOffset(
            (viewport.X - width) / 2,
            (viewport.Y - height) / 2
        )

        Title.TextSize = 16
        Title.Size = UDim2.fromOffset(95, 65)
        MainTabBar.Position = UDim2.fromOffset(110, 0)
        MainTabBar.Size = UDim2.new(1, -116, 1, 0)
        Sidebar.Size = UDim2.new(0, 100, 1, -66)

        for tabName, data in pairs(MainTabButtons) do
            data.Button.TextSize = 11
            data.Button.Size = UDim2.fromOffset(
                math.max(66, MainTabWidths[tabName] - 12),
                36
            )
        end
    else
        Window.Size = UDim2.fromOffset(620, 390)
        Window.Position = UDim2.fromOffset(
            (viewport.X - 620) / 2,
            (viewport.Y - 390) / 2
        )

        Title.TextSize = 18
        Title.Size = UDim2.fromOffset(115, 65)
        MainTabBar.Position = UDim2.fromOffset(132, 0)
        MainTabBar.Size = UDim2.new(1, -140, 1, 0)
        Sidebar.Size = UDim2.new(0, 124, 1, -66)

        for tabName, data in pairs(MainTabButtons) do
            data.Button.TextSize = 12
            data.Button.Size = UDim2.fromOffset(
                MainTabWidths[tabName],
                36
            )
        end
    end
end

if workspace.CurrentCamera then
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(
        UpdateMenuSize
    )
end

Window:GetPropertyChangedSignal("Visible"):Connect(function()
    if Window.Visible then
        SelectMainTab(CurrentMainTab)
    else
        Sidebar.Visible = false
    end
end)

UpdateMenuSize()
SelectMainTab("Main")

print("Gumball UI loaded.")
