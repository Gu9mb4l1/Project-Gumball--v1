    local MainButton = Create("TextButton", {
        Name = tabName .. "Button",
        BackgroundColor3 = Colors.HeaderColor,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(MainTabWidths[tabName], 36),
        Font = Enum.Font.GothamMedium,
        Text = tabName,
        TextColor3 = Colors.MutedColor,
        TextSize = 12,
        AutoButtonColor = false,
        LayoutOrder = index,
        ZIndex = 5,
    }, MainTabBar)

    AddCorner(MainButton, 5)

    local Indicator = Create("Frame", {
        Name = "ActiveIndicator",
        BackgroundColor3 = Colors.AccentColor,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -1),
        Size = UDim2.new(0, 20, 0, 2),
        Visible = tabName == "Main",
        ZIndex = 6,
    }, MainButton)

    MainTabButtons[tabName] = {
        Button = MainButton,
        Indicator = Indicator,
    }

    MainButton.MouseEnter:Connect(function()
        if CurrentMainTab ~= tabName then
            Animate(MainButton, {
                BackgroundTransparency = 0,
                BackgroundColor3 = Colors.HoverColor,
                TextColor3 = Colors.FontColor,
            })
        end
    end)

    MainButton.MouseLeave:Connect(function()
        if CurrentMainTab ~= tabName then
            Animate(MainButton, {
                BackgroundTransparency = 1,
                TextColor3 = Colors.MutedColor,
            })
        end
    end)

    -- One separate vertical list of sub-tabs in the connected sidebar
    for subIndex, subName in ipairs(TabDefinitions[tabName]) do
        local SubButton = Create("TextButton", {
            Name = subName:gsub("%s+", "") .. "Button",
            BackgroundColor3 = subIndex == 1
                and Colors.SelectedColor
                or Colors.HeaderColor,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 34),
            Font = Enum.Font.GothamMedium,
            Text = subName,
            TextColor3 = subIndex == 1
                and Colors.FontColor
                or Colors.MutedColor,
            TextSize = 12,
            TextWrapped = true,
            AutoButtonColor = false,
            LayoutOrder = subIndex,
            Visible = tabName == CurrentMainTab,
            ZIndex = 5,
        }, SidebarList)

        AddCorner(SubButton, 5)

        local ActiveBar = Create("Frame", {
            Name = "ActiveBar",
            BackgroundColor3 = Colors.AccentColor,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(0, 7),
            Size = UDim2.fromOffset(2, 20),
            Visible = subIndex == 1 and tabName == CurrentMainTab,
            ZIndex = 6,
        }, SubButton)

        local SubPage = Create("Frame", {
            Name = subName:gsub("%s+", "") .. "Page",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(14, 12),
            Size = UDim2.new(1, -28, 1, -24),
            Visible = subIndex == 1,
            ZIndex = 2,
        }, Page)

        SubTabButtons[tabName][subName] = {
            Button = SubButton,
            ActiveBar = ActiveBar,
        }

        SubTabPages[tabName][subName] = SubPage

        if subIndex == 1 then
            CurrentSubTab[tabName] = subName
        end

        SubButton.MouseEnter:Connect(function()
            if CurrentSubTab[tabName] ~= subName then
                Animate(SubButton, {
                    BackgroundColor3 = Colors.HoverColor,
                    TextColor3 = Colors.FontColor,
                })
            end
        end)

        SubButton.MouseLeave:Connect(function()
            if CurrentSubTab[tabName] ~= subName then
                Animate(SubButton, {
                    BackgroundColor3 = Colors.HeaderColor,
                    TextColor3 = Colors.MutedColor,
                })
            end
        end)

        SubButton.Activated:Connect(function()
            CurrentSubTab[tabName] = subName

            for name, data in pairs(SubTabButtons[tabName]) do
                local selected = name == subName

                data.ActiveBar.Visible = selected

                Animate(data.Button, {
                    BackgroundColor3 = selected
                        and Colors.SelectedColor
                        or Colors.HeaderColor,
                    TextColor3 = selected
                        and Colors.FontColor
                        or Colors.MutedColor,
                })
            end

            for name, page in pairs(SubTabPages[tabName]) do
                page.Visible = name == subName
            end
        end)
    end
end

local function SelectMainTab(tabName)
    CurrentMainTab = tabName

    for name, page in pairs(MainTabPages) do
        page.Visible = name == tabName
    end

    for name, data in pairs(MainTabButtons) do
        local selected = name == tabName

        data.Indicator.Visible = selected

        Animate(data.Button, {
            TextColor3 = selected
                and Colors.FontColor
                or Colors.MutedColor,
            BackgroundTransparency = selected and 0 or 1,
            BackgroundColor3 = selected
                and Colors.SelectedColor
                or Colors.HeaderColor,
        })
    end

    Sidebar.Visible = #TabDefinitions[tabName] > 0

    for tab, buttons in pairs(SubTabButtons) do
        for subName, data in pairs(buttons) do
            local selected = tab == tabName
                and CurrentSubTab[tab] == subName

            data.Button.Visible = tab == tabName
            data.ActiveBar.Visible = selected
            data.Button.BackgroundColor3 = selected
                and Colors.SelectedColor
                or Colors.HeaderColor
            data.Button.TextColor3 = selected
                and Colors.FontColor
                or Colors.MutedColor
        end
    end
end

for tabName, data in pairs(MainTabButtons) do
    data.Button.Activated:Connect(function()
        SelectMainTab(tabName)
    end)
end

-- Drag the menu using its header
local Dragging = false
local DragStart
local WindowStart

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        DragStart = input.Position
        WindowStart = Window.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if Dragging and DragStart and WindowStart then
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - DragStart

            Window.Position = UDim2.new(
                WindowStart.X.Scale,
                WindowStart.X.Offset + delta.X,
                WindowStart.Y.Scale,
                WindowStart.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = false
        DragStart = nil
        WindowStart = nil
    end
end)

