-- Horizontal scrolling for the category tabs.
tabs.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		local maxScroll = math.max(
			0,
			tabs.AbsoluteCanvasSize.X - tabs.AbsoluteSize.X
		)

		tabs.CanvasPosition = Vector2.new(
			math.clamp(
				tabs.CanvasPosition.X - input.Position.Z * 55,
				0,
				maxScroll
			),
			0
		)
	end
end)

-- Drag the main window using the header.
local dragging = false
local dragStart
local startPosition
local dragInput

header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		local overTabs =
			input.Position.X >= tabs.AbsolutePosition.X
			and input.Position.X <= tabs.AbsolutePosition.X + tabs.AbsoluteSize.X
			and input.Position.Y >= tabs.AbsolutePosition.Y
			and input.Position.Y <= tabs.AbsolutePosition.Y + tabs.AbsoluteSize.Y

		if overTabs then
			return
		end

		dragging = true
		dragStart = input.Position
		startPosition = window.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

header.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input == dragInput then
		local delta = input.Position - dragStart

		window.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

-- PC menu toggle.
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.RightShift then
		window.Visible = not window.Visible
	end
end)

-- Movable mobile Toggle button.
local mobileToggle = Instance.new("TextButton")
mobileToggle.Name = "MobileToggle"
mobileToggle.Position = UDim2.fromOffset(12, 70)
mobileToggle.Size = UDim2.fromOffset(72, 38)
mobileToggle.BackgroundColor3 = COLORS.Header
mobileToggle.Text = "Toggle"
mobileToggle.TextColor3 = COLORS.White
mobileToggle.TextSize = 13
mobileToggle.Font = Enum.Font.GothamBold
mobileToggle.Visible = UserInputService.TouchEnabled
mobileToggle.AutoButtonColor = true
mobileToggle.Active = true
mobileToggle.ZIndex = 20
mobileToggle.Parent = gui

Instance.new("UICorner", mobileToggle).CornerRadius = UDim.new(0, 8)

local toggleBorder = Instance.new("UIStroke")
toggleBorder.Color = COLORS.Border
toggleBorder.Thickness = 1
toggleBorder.Parent = mobileToggle

local toggleDragging = false
local toggleMoved = false
local toggleDragStart = nil
local toggleStartPosition = nil
local toggleDragInput = nil
local toggleInputType = nil

mobileToggle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		toggleDragging = true
		toggleMoved = false
		toggleDragStart = input.Position
		toggleStartPosition = mobileToggle.Position
		toggleDragInput = input
		toggleInputType = input.UserInputType
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not toggleDragging then
		return
	end

	if toggleInputType == Enum.UserInputType.Touch then
		if input ~= toggleDragInput then
			return
		end
	elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
		return
	end

	local delta = input.Position - toggleDragStart

	if delta.Magnitude > 5 then
		toggleMoved = true
	end

	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
	local buttonSize = mobileToggle.AbsoluteSize

	local x = toggleStartPosition.X.Offset + delta.X
	local y = toggleStartPosition.Y.Offset + delta.Y

	x = math.clamp(x, 0, math.max(0, viewport.X - buttonSize.X))
	y = math.clamp(y, 0, math.max(0, viewport.Y - buttonSize.Y))

	mobileToggle.Position = UDim2.fromOffset(x, y)
end)

UserInputService.InputEnded:Connect(function(input)
	if not toggleDragging then
		return
	end

	if input == toggleDragInput
		or (
			toggleInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseButton1
		) then

		toggleDragging = false
		toggleDragInput = nil
	end
end)

mobileToggle.Activated:Connect(function()
	if toggleMoved then
		toggleMoved = false
		return
	end

	window.Visible = not window.Visible
end)
