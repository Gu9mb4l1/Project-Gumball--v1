local thunderSoundId = ""
local lightningOn = false
local lightningInterval = 8
local lightningFlash = 0.8
local lightningToken = 0

worldTextBox(skyPage, "Thunder SoundId", "Optional thunder audio asset ID", "rbxassetid://...", function(value)
    thunderSoundId = value
end)

worldSlider(skyPage, "Lightning interval", "Average delay between lightning flashes", 2, 30, lightningInterval, 0, function(v)
    lightningInterval = v
end)

worldSlider(skyPage, "Lightning flash", "Brightness added during each flash", 0.1, 5, lightningFlash, 1, function(v)
    lightningFlash = v
end)

worldToggle(skyPage, "Lightning", "Enable local lightning flashes and optional thunder", false, function(on)
    lightningOn = on
    lightningToken += 1
    local token = lightningToken

    if on then
        task.spawn(function()
            while lightningOn and token == lightningToken do
                task.wait(math.random(
                    math.max(1, lightningInterval - 2),
                    lightningInterval + 2
                ))

                if not lightningOn or token ~= lightningToken then break end

                local previousBrightness = Lighting.Brightness
                Lighting.Brightness = math.clamp(previousBrightness + lightningFlash, 0, 10)
                task.wait(0.12)
                Lighting.Brightness = previousBrightness

                if thunderSoundId ~= "" then
                    local sound = Instance.new("Sound")
                    sound.Name = "GumballLocalThunder"
                    sound.SoundId = thunderSoundId:match("^rbxasset") and thunderSoundId or ("rbxassetid://" .. thunderSoundId:gsub("%D", ""))
                    sound.Volume = 0.7
                    sound.Parent = workspace.CurrentCamera or workspace
                    sound:Play()
                    sound.Ended:Connect(function() sound:Destroy() end)
                    task.delay(12, function()
                        if sound.Parent then sound:Destroy() end
                    end)
                end
            end
        end)
    end
end)

