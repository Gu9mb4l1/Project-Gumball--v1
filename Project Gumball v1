local function selectWorldTab(name)
    for tabName, page in pairs(worldPages) do
        local active = tabName == name
        page.Visible = active
        worldButtons[tabName].BackgroundColor3 =
            active and COLORS.Selected or worldPanel
        worldButtons[tabName].TextColor3 =
            active and COLORS.White or COLORS.Inactive
    end
end

for name, button in pairs(worldButtons) do
    button.Activated:Connect(function()
        selectWorldTab(name)
    end)
end

local function worldHeader(parent, heading, subtitle)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -4, 0, subtitle and 52 or 30)
    frame.BackgroundTransparency = 1
    frame.Parent = parent

    makeLabel(
        frame, "Heading", string.upper(heading),
        UDim2.fromOffset(2, 0),
        UDim2.new(1, -4, 0, 24),
        14, COLORS.White, Enum.Font.GothamBold
    )

    if subtitle then
        makeLabel(
            frame, "Subtitle", subtitle,
            UDim2.fromOffset(2, 24),
            UDim2.new(1, -4, 0, 22),
            11, COLORS.Muted
        )
    end

    return frame
end

local function worldRow(parent, name, description, height)
    local row = Instance.new("Frame")
    row.Name = name:gsub("%W", "") .. "Row"
    row.Size = UDim2.new(1, -4, 0, height or 56)
    row.BackgroundColor3 = worldPanel
    row.BorderSizePixel = 0
    row.Parent = parent
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)

    local stroke = Instance.new("UIStroke")
    stroke.Color = worldBorder
    stroke.Thickness = 1
    stroke.Parent = row

    makeLabel(
        row, "Label", name,
        UDim2.fromOffset(12, 5),
        UDim2.new(1, -155, 0, 20),
        12, COLORS.White, Enum.Font.GothamMedium
    )

    if description then
        makeLabel(
            row, "Description", description,
            UDim2.fromOffset(12, 26),
            UDim2.new(1, -155, 0, 18),
            10, COLORS.Muted
