local function selectTab(name)
    selectedTab = name

    for tabName, parts in pairs(tabButtons) do
        local active = tabName == name
        parts.Label.TextColor3 =
            active and COLORS.White or COLORS.Inactive
        parts.Underline.Visible = active
    end

    for pageName, page in pairs(pageFrames) do
        page.Visible = pageName == name
    end
end

