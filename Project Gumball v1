local function makeChips(parent, options, startY, selectedMap, prefix)
	local chipFrame = Instance.new("Frame")
	chipFrame.Name = prefix .. "Options"
	chipFrame.Position = UDim2.fromOffset(24, startY)
	chipFrame.Size = UDim2.new(1, -48, 0, 72)
	chipFrame.BackgroundTransparency = 1
