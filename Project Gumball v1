local unlockEnabled = false
local runtimeEnabled = false
local selectedTypes = {}

local selectedRarities = {
    Legendary = true,
    Mythical = true,
    Unobtainable = true,
}

local status

local function sendUnlockRequest()
    if not unlockRemote or not unlockRemote:IsA("RemoteFunction") then
        if status then
            status.Text = "Missing GumballUnlockCosmetics RemoteFunction."
        end
        return
    end

    local ok, result = pcall(function()
        return unlockRemote:InvokeServer({
            enabled = runtimeEnabled and unlockEnabled,
            types = selectedTypes,
            rarities = selectedRarities,
        })
    end)

    if ok and result then
        status.Text = result.message or "Cosmetic setting updated."
        status.TextColor3 = COLORS.Green
    else
        status.Text = "Request failed. Check the server script and Output."
        status.TextColor3 = COLORS.Amber
        warn("Gumball unlock request failed:", result)
    end
end

local function makeToggleRow(
    parent,
    name,
    description,
    y,
    initial,
    callback
)
    local row = Instance.new("Frame")
    row.Name = name .. "Row"
    row.Position = UDim2.fromOffset(24, y)
    row.Size = UDim2.new(1, -48, 0, 58)
    row.BackgroundTransparency = 1
    row.Parent = parent

    makeLabel(
        row,
        name .. "Label",
        name,
        UDim2.fromOffset(0, 3),
        UDim2.new(1, -90, 0, 22),
        14,
        COLORS.White,
        Enum.Font.GothamMedium
    )

    makeLabel(
        row,
        name .. "Description",
        description,
        UDim2.fromOffset(0, 27),
        UDim2.new(1, -90, 0, 20),
        11,
        COLORS.Inactive
    )

    local toggle = Instance.new("TextButton")
    toggle.Name = name .. "Toggle"
    toggle.AnchorPoint = Vector2.new(1, 0.5)
    toggle.Position = UDim2.new(1, 0, 0.5, 0)
    toggle.Size = UDim2.fromOffset(54, 28)
    toggle.BackgroundColor3 =
        initial and COLORS.Green or COLORS.Selected
    toggle.BorderSizePixel = 0
    toggle.Text = initial and "ON" or "OFF"
    toggle.TextColor3 = COLORS.White
    toggle.TextSize = 11
    toggle.Font = Enum.Font.GothamBold
    toggle.Parent = row

    Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 7)

    local stroke = Instance.new("UIStroke")
    stroke.Color = COLORS.Border
    stroke.Thickness = 1
    stroke.Parent = toggle

    local value = initial

    toggle.Activated:Connect(function()
        value = not value

        toggle.Text = value and "ON" or "OFF"
        toggle.BackgroundColor3 =
            value and COLORS.Green or COLORS.Selected

        callback(value)
    end)

    return toggle
end

