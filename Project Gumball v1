local function applySky(name)
    local data = skyPresets[name]
    if not data then return end

    local sky
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("Sky") then
            sky = child
            break
        end
    end

    if not sky then
        sky = Instance.new("Sky")
        sky.Parent = Lighting
    end

    sky.Name = "GumballWorld_Sky"
    sky.SkyboxUp = "rbxassetid://" .. data[1]
    sky.SkyboxBk = "rbxassetid://" .. data[2]
    sky.SkyboxFt = "rbxassetid://" .. data[3]
    sky.SkyboxDn = "rbxassetid://" .. data[4]
    sky.SkyboxLf = "rbxassetid://" .. data[5]
    sky.SkyboxRt = "rbxassetid://" .. data[6]
    skyStatus.Text = "Applied sky: " .. name
end

